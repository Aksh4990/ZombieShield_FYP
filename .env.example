# Database settings used by Docker Compose
POSTGRES_DB=zombieshield
POSTGRES_USER=zombieshield
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Backend settings
DATABASE_URL=postgresql+psycopg://zombieshield:change-me-for-local-development@db:5432/zombieshield
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend build-time backend URL
VITE_API_BASE_URL=http://localhost:8000
